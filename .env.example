PORT=8000
AI_PORT=8001

SECRET_KEY=

# Groq speech-to-text (apps/ai). POC: audio is sent to Groq for post-recording enhance.
GROQ_API_KEY=
# Optional overrides (defaults shown)
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# GROQ_TIMEOUT_MS=120000

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Opt. sans clé PubMed est limité à 3 req/s (contre 10 avec clé)
# Gratuit sur : https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# Opt. email de contact NCBI (recommandé : tool + email dans chaque requête E-utilities)
NCBI_EMAIL=

# Durée de vie du access token JWT
ACCESS_TOKEN_TTL=1h

# Durée de vie du refresh token en jours
REFRESH_TOKEN_TTL_DAYS=7

# URL publique de l'app (liens reset / recovery dans les e-mails)
# Les e-mails pointent vers cette origine HTTPS ; l'API renvoie une page
# qui ouvre l'app via APP_DEEPLINK_SCHEME (pas de front web).
APP_PUBLIC_URL=http://localhost:3000

# Schema custom pour ouvrir l'app native (medicail://reset-password?token=…)
APP_DEEPLINK_SCHEME=medicail

# Origines CORS autorisees (virgule). Defaut = APP_PUBLIC_URL. Vide = CORS desactive.
CORS_ORIGINS=http://localhost:3000

# Code d'invitation pour POST /auth/register. Sans cette variable, seul le premier PRATICIEN peut s'inscrire.
REGISTRATION_INVITE_CODE=

# Proton SMTP (ou Bridge local : 127.0.0.1:1025)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Local only. Production never skips mail. Without this, missing SMTP fails the request.
MAIL_SKIP=

# WebAuthn / passkeys (prod : medicail.nf2.tech)
# RP_ID must be a hostname only (no https://). RP_NAME is shown in OS passkey dialogs.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Medicail
WEBAUTHN_ORIGIN=http://localhost:3000
