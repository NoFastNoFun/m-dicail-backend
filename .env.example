# Copy this file to .env and fill in your values
# .env is ignored by git — never commit real secrets

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Optional — without it PubMed is limited to 3 req/s instead of 10
# Get a free key at: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=
