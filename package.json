{
  "name": "m-dicail-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "nest build api && nest build ai",
    "build:api": "nest build api",
    "build:ai": "nest build ai",
    "start:dev:api": "nest start api --watch",
    "start:dev:ai": "nest start ai --watch",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\"",
    "lint:code": "eslint \"{apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc -p apps/api/tsconfig.app.json --noEmit && tsc -p apps/ai/tsconfig.app.json --noEmit && tsc -p libs/shared/tsconfig.lib.json --noEmit",
    "dead-code": "knip",
    "pre-check": "pnpm run format && pnpm run lint:code && pnpm run typecheck && pnpm run dead-code && pnpm run test:coverage",
    "prepare": "husky || true",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:coverage": "jest --coverage",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d apps/api/src/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d apps/api/src/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d apps/api/src/data-source.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/typeorm": "^10.0.2",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.0",
    "express": "^4.22.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/xml2js": "^0.4.14",
    "eslint": "^9.0.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "knip": "^6.24.0",
    "prettier": "^3.4.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.0",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.62.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "apps/api/src/features/**/services/**/*.ts",
      "apps/api/src/features/**/*.controller.ts",
      "apps/api/src/features/**/exceptions/**/*.ts",
      "libs/shared/src/filters/**/*.ts",
      "libs/shared/src/guards/**/*.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@features/(.*)$": "<rootDir>/apps/api/src/features/$1",
      "^@config/(.*)$": "<rootDir>/apps/api/src/config/$1",
      "^@app/shared$": "<rootDir>/libs/shared/src/index",
      "^@app/shared/(.*)$": "<rootDir>/libs/shared/src/$1"
    },
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ]
  }
}
